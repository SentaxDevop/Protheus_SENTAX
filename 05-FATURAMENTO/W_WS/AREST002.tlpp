#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace Custom.Vendas

/*/{Protheus.doc} SuzanoSellOutController
    CONTROLLER REST - Endpoints Suzano
    @type class
    @version 1.0
    @author Alfred Andersen
    @since 3/30/2026
/*/
class SuzanoSellOutController

	Public Data cDataDe  as Character
	Public Data cDataAte as Character

    public method New() as object

    @Get(endpoint="/custom/get/Suzano/Sell-Out", description="Sell-Out and Stock - Suzano")
    public method GetSellOut() as object

    @Get(endpoint="/custom/get/Suzano/Estoque", description="Estoque - Suzano")
    public method GetEstoque() as object

    @Get(endpoint="/custom/get/Suzano/Painel", description="Painel - Suzano")
    public method GetPainel() as object

endclass

method New() class SuzanoSellOutController

    ::cDataDe  := ""//DTOS(Date() - GetNewPar("ST_SUZAN01",60))
    ::cDataAte := ""//DTOS(Date())

Return Self

/*/{Protheus.doc} SuzanoSellOutController::GetSellOut
    GET /custom/get/Suzano/Sell-Out
    @type method
    @version 1.0
    @author Alfred Andersen
    @since 3/30/2026
/*/
method GetSellOut() class SuzanoSellOutController

    local oVendas   as object
    local cJson     as character
    local cJsonUTF8 as character
    local cParamDe  as character
    local cParamAte as character
    local jQuery    as object

    // Lê os parãmetros DataDe e DataAte enviados via query string
    // Formato esperado: YYYY-MM-DD (ISO 8601), ex: 2025-01-31
    jQuery    := oRest:getQueryRequest()
    cParamDe  := jQuery["DataDe"]
    cParamAte := jQuery["DataAte"]

    // Garante que os valores sejam character (JsonObject retorna Nil se a chave não existir)
    if ValType(cParamDe)  != "C" ; cParamDe  := "" ; endif
    if ValType(cParamAte) != "C" ; cParamAte := "" ; endif    

    // Converte de YYYY-MM-DD para YYYYMMDD (formato interno DTOS do Protheus)
    cParamDe  := StrTran(AllTrim(cParamDe) , "-", "")
    cParamAte := StrTran(AllTrim(cParamAte), "-", "")

    // Valida presença obrigatória dos parâmetros
    if Empty(cParamDe) .or. Empty(cParamAte)
        oRest:setStatusCode(400)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"Os parametros DataDe e DataAte sao obrigatorios. Formato esperado: YYYY-MM-DD."}')
        Return
    endif

    // Valida se DataDe é uma data válida
    if Len(cParamDe) <> 8 .or. StoD(cParamDe) == CtoD("")
        oRest:setStatusCode(400)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"DataDe invalida. Formato esperado: YYYY-MM-DD."}')
        Return
    endif

    // Valida se DataAte é uma data válida
    if Len(cParamAte) <> 8 .or. StoD(cParamAte) == CtoD("")
        oRest:setStatusCode(400)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"DataAte invalida. Formato esperado: YYYY-MM-DD."}')
        Return
    endif

    // Valida consistência: DataDe não pode ser maior que DataAte
    if cParamDe > cParamAte
        oRest:setStatusCode(400)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"DataDe nao pode ser maior que DataAte."}')
        Return
    endif

    // Atribui os valores validados às variáveis da classe
    ::cDataDe  := cParamDe
    ::cDataAte := cParamAte

    begin sequence

        oVendas := JsonVendas():New(::cDataDe, ::cDataAte)
        cJson   := oVendas:BuildJson()

        if Empty(cJson) .or. cJson == "[]"
            oRest:setStatusCode(204)
            oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
            oRest:setKeyHeaderResponse("Content-Encoding", "identity")
            oRest:setResponse('{"status":"sem dados","mensagem":"Nenhum registro encontrado."}')
        else
            cJsonUTF8 := EncodeUTF8(cJson, "cp1252")
            if Empty(cJsonUTF8)
                cJsonUTF8 := cJson
            endif
            oRest:setStatusCode(200)
            oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
            oRest:setKeyHeaderResponse("Content-Encoding", "identity")
            oRest:setResponse(cJsonUTF8)
        endif

    recover

        oRest:setStatusCode(500)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"Falha ao gerar o JSON de Sell-Out."}')

    end sequence

    FreeObj(oVendas)

Return

/*/{Protheus.doc} SuzanoSellOutController::GetEstoque
    GET /custom/get/Suzano/Estoque
    @type method
    @version 1.0
    @author Alfred Andersen
    @since 3/30/2026
/*/
method GetEstoque() class SuzanoSellOutController

    local oEstoque  as object
    local cJson     as character
    local cJsonUTF8 as character

    begin sequence

        oEstoque := JsonEstoque():New()
        cJson    := oEstoque:BuildJson()

        if Empty(cJson) .or. cJson == "[]"
