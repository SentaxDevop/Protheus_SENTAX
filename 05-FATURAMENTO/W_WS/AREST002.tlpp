            oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
            oRest:setKeyHeaderResponse("Content-Encoding", "identity")
            oRest:setResponse('{"status":"sem dados","mensagem":"Nenhum registro encontrado."}')
        else
            cJsonUTF8 := EncodeUTF8(cJson, "cp1252")
            if Empty(cJsonUTF8)
                cJsonUTF8 := cJson
            endif
            oRest:setStatusCode(200)
            oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
            oRest:setKeyHeaderResponse("Content-Encoding", "identity")
            oRest:setResponse(cJsonUTF8)
        endif

    recover

        oRest:setStatusCode(500)
        oRest:setKeyHeaderResponse("Content-Type"    , "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Content-Encoding", "identity")
        oRest:setResponse('{"status":"erro","mensagem":"Falha ao gerar o JSON de Estoque."}')

    end sequence

    FreeObj(oEstoque)

Return

// -------------------------------------------------------------
// GET /custom/get/Suzano/Painel
// -------------------------------------------------------------
