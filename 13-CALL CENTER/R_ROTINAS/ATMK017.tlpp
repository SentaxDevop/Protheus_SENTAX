#include "topconn.ch"
#include "totvs.ch"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TBICONN.CH"

/*/{Protheus.doc} ATMK017
	Realiza a inclusão do Produto x Equipamento e chama a rotina de Chamado Técnico
	@type function
	@version 1.0
	@author Alfred Andersen
	@since 2/24/2025
/*/
User Function ATMK017(nOpc)

    Local nX          := 0               as Numeric
	Local cObs        := ""              as Character
	Local cCliente    := SUA->UA_CLIENTE as Character
	Local cLoja       := SUA->UA_LOJA    as Character
	Local cProduto    := ""              as Character
	Local cProdDescri := ""              as Character
	Local aCab040     := {}              as Array
	Local aItens040   := {}              as Array
	Local aChamado    := {}              as Array

	Private lMsErroAuto := .F.

	If FWAlertYesNo("Deseja abrir o chamado neste momento?", "Chamado Técnico")
		
		//Atendimento
		If nOpc <> "3"

			If Len(aDadosSUB) > 0

				For nX := 1 to len(aDadosSUB)

					cObs := 	"Inclusão Automática da Base de Atendimento pelo Call Center"+CHR(13)+CHR(10)+;
					"Atendimmento: "+Alltrim(SUA->UA_NUM)+" Data: "+DtoC(dDataBase)+" e Hora: "+Time()

					cProduto := aDadosSUB[nX, 1]
					cProdDescri := Alltrim(GetAdvFVal("SB1","B1_DESC",FWxFilial("SB1") + aDadosSUB[nX, 1],1))
					cConteud := GetMV("MV_FORMGAR")

					DbSelectArea("AA3") 
					AA3->(DbSetOrder(1)) // AA3_FILIAL+AA3_CODCLI+AA3_LOJA+AA3_CODPRO+AA3_NUMSER
					If !AA3->(DbSeek(xFilial("AA3") + cCliente + cLoja + cProduto))

						aadd(aCab040, {"AA3_FILIAL", FWxFilial("AA3")                             , NIL})
						aadd(aCab040, {"AA3_CODCLI", cCliente                                     , NIL})
						aadd(aCab040, {"AA3_LOJA"  , cLoja                                        , NIL})
						aadd(aCab040, {"AA3_CODPRO", aDadosSUB[nX, 1]                             , NIL})
						aadd(aCab040, {"AA3_NUMSER", Alltrim(cCliente) + cLoja + Alltrim(cProduto), NIL})
						aadd(aCab040, {"AA3_DTVEN" , dDataBase                                    , NIL})

						aadd(aCab040, {"AA3_DTGAR" , &(cConteud)                                  , NIL})
						aadd(aCab040, {"AA3_NFVEND", "ZZZZZZZZZ"                                  , NIL})
						aadd(aCab040, {"AA3_HORDIA", GetNewPar("MV_HOPEDIA", 8)                   , NIL})
						aadd(aCab040, {"AA3_STATUS", "01"                                         , NIL})
						aadd(aCab040, {"AA3_DIAOPE", GetNewPar("MV_DOPESEM", 5)                   , NIL})

						aadd(aCab040, {"AA3_DSCPRO", cProdDescri                                  , NIL})
						aadd(aCab040, {"AA3_CODFAB", cCliente                                     , NIL})
						aadd(aCab040, {"AA3_LOJAFA", cLoja                                        , NIL})
						aadd(aCab040, {"AA3_OBS"   , cObs                                         , NIL})

						TECA040(,aCab040,aItens040,3) 

						If lMsErroAuto   

							MsgAlert("Erro ao incluir base instalada para o Cliente/Loja: "+cCliente+"/"+cLoja+ "e Produto: "+cProduto,"Atenção [PE TMKVFIM]")				

						Endif 

					End

				Next

			End

		End
	
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Chama a tela de inclusao do chamado tecnico³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ

		SA1->(DbSetOrder(1))
		SA1->(DbSeek(FWxFilial("SA1") + SUA->UA_CLIENTE + SUA->UA_LOJA))

		Aadd(aChamado,{"AB1_CODCLI",SUA->UA_CLIENTE})
		Aadd(aChamado,{"AB1_LOJA"  ,SUA->UA_LOJA})
		Aadd(aChamado,{"AB1_CONTAT",SUA->UA_DESCNT})

		TECA300("At300Inclu",aChamado)

		If ATMK017C(SUA->UA_CLIENTE, SUA->UA_LOJA)
			ATMK017A(AB1->AB1_NRCHAM)
		Else
			If !Empty(AB1->AB1_NRCHAM)
				FWAlertSuccess("Registro incluído com sucesso! Nº " + Alltrim(AB1->AB1_NRCHAM), "Chamado Técnico")
			End
		End

	End

Return

/*/{Protheus.doc} ATMK017A
	Realiza a alteração do Chamado Técnico para OS.
	@type function
	@version 1.0
	@author Alfred Andersen
	@since 11/2/2026
/*/
Static Function ATMK017A(cChamado)
		
	Local aCabec    := {} as Array
	Local aItens    := {} as Array
	Local aErroAuto := {} as Array
	Local cLog      := "" as Character
	Local nI        := 0  as Numeric

	Private lMSErroAuto    := .F. //Determina se houve algum tipo de erro durante a execucao do ExecAuto
	Private lAutoErrNoFile := .T. //Habilita a gravacao de erro da rotina automatica
	Private lMSHelpAuto    := .T. //Define se mostra ou não os erros na tela (T= Nao mostra; F=Mostra)

	// AB1 ja posicionada
	aCabec := ATMK017B("AB1")

	AB2->(DbSetOrder(1))
	If AB2->(DbSeek(xFilial("AB2") + AB1->AB1_NRCHAM))

		While AB2->(!Eof()) .And. AB2->AB2_FILIAL == xFilial("AB2") .And. ;
			AB2->AB2_NRCHAM == AB1->AB1_NRCHAM

			aAdd(aItens, ATMK017B("AB2", {{"AB2_TIPO", "3"}}))

			AB2->(DbSkip())
		EndDo

	EndIf

	TECA300(,,aCabec,aItens,4)

	If !lMsErroAuto

		FWAlertSuccess("Registro de OS incluído com sucesso!", "Ordem de Serviço")

	Else
		aErroAuto := GetAutoGRLog()

		For nI := 1 To Len(aErroAuto)
			cLog += aErroAuto[nI] + CRLF
		Next

		cLog += "Usuário logado: " + __cUserID + CRLF

		cMail := GetMV("ST_MAILTI")
		cAssunto := "Falha na conversao Chamado Tecnico " +cChamado+ " para a Ordem de Serviço"

		u_MailTo(cMail, cAssunto, "", "", cLog, "")

		FWAlertError("Falha na conversão do Chamado Técnico para a OS.", "Ordem de Serviço")

	EndIf

Return

/*/{Protheus.doc} ATMK017B
	@type function
	@version 1.0
	@author Alfred Andersen
	@since 11/2/2026
	@param cAlias, character, alias posicionado (AB1, AB2...)
	@param aAltera, array, {{"CAMPO", novoValor}, ...} -> campos a sobrescrever
	@param aIgnora, array, {"CAMPO1","CAMPO2"}         -> campos a nao enviar
/*/
Static Function ATMK017B(cAlias, aAltera, aIgnora)

    Local aRet   := {} as Array
    Local nI     := 0  as Numeric
    Local nPos   := 0  as Numeric
    Local cCampo := "" as Character
    Local xValor := Nil

    Default aAltera := {}
    Default aIgnora := {}

    For nI := 1 To (cAlias)->(FCount())
        cCampo := AllTrim((cAlias)->(FieldName(nI)))

        // Filial e campos explicitamente ignorados
        If "_FILIAL" $ cCampo .Or. aScan(aIgnora, {|x| AllTrim(x) == cCampo}) > 0
            Loop
        EndIf

        // Campos nao usados no dicionario
        If !X3Uso(GetSX3Cache(cCampo, "X3_USADO"))
            Loop
        EndIf

        nPos   := aScan(aAltera, {|x| AllTrim(x[1]) == cCampo})
        xValor := IIf(nPos > 0, aAltera[nPos][2], (cAlias)->(FieldGet(nI)))

        aAdd(aRet, {cCampo, xValor, Nil})
    Next nI

Return aRet

/*/{Protheus.doc} ATMK017C
	Consulta se há titulos vencidos para o cliente
	@type function
	@version 1.0
	@author Alfred Andersen
	@since 11/2/2026
	@param cCodigo, character, Código do Cliente 
	@param cLoja, character, Código da Loja do Cliente
	@return variant, Retorna True se não há títulos vencidos
/*/
Static Function ATMK017C(cCodigo, cLoja)

    Local cAliasA := GetNextAlias() as character
    Local lRet    := .T.            as logical

	If Select(cAliasA) > 0
		(cAliasA)->(DbCloseArea())
	EndIf

	BeginSql Alias cAliasA
		SELECT TOP 1 E1_NUM
		FROM %Table:SE1% SE1 (NOLOCK)
		WHERE SE1.%NotDel%
		AND E1_CLIENTE = %Exp:cCodigo%
		AND E1_LOJA    = %Exp:cLoja%
		AND E1_SALDO   > 0
		AND E1_VENCREA < %Exp:DToS(dDataBase)%
		AND E1_TIPO NOT IN ('PR', 'NCC', 'RA')
		AND E1_TIPO NOT LIKE '%-'
	EndSql

	lRet := (cAliasA)->(Eof())   // .T. = nenhum titulo vencido

	(cAliasA)->(DbCloseArea())

Return lRet
