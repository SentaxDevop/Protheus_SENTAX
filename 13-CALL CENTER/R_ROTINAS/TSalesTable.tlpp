#INCLUDE "PROTHEUS.CH"
#INCLUDE "TOPCONN.CH"
#INCLUDE "FWMVCDEF.CH"
#Include "TOTVS.ch"
#Include "RESTFul.ch"

/*/{Protheus.doc} TSalesTable
Classe responsável pela gestão da tabela VENDAS
@type class
@version 1
@author Alfred Andersen
@since 06/06/2023
/*/
Class TSalesTable

	Public Data cDataLimite as Character
	
	Public Method New() Constructor
	Public Method Process()
    Public Method DeleteRecords()
    Public Method InsertRecords()

EndClass

/*/{Protheus.doc} TSalesTable::New
Método construtor da classe 
@type method
@version 1
@author Alfred Andersen
@since 06/06/2023
/*/
Method New() Class TSalesTable

	::cDataLimite := ""

Return(Self)

/*/{Protheus.doc} TSalesTable::Process
Método principal da classe, direcionando as ações em sequência 
@type method
@version 1 
@author Alfred Andersen
@since 06/06/2023
/*/
Method Process() Class TSalesTable

	ConOut("Chamada de delecao da tabela VENDAS na data: "	+	DTOC(::cDataLimite) + "	Inicio " + DTOC(dDatabase) + " - " + TIME())
	::DeleteRecords()

	ConOut("Chamada de Insercao da tabela VENDAS na data: "	+	DTOC(::cDataLimite) + "	Inicio " + DTOC(dDatabase) + " - " + TIME())
	::InsertRecords()

Return

/*/{Protheus.doc} TSalesTable::DeleteRecords
Realiza a exclusão dos dados da tabela VENDAS com conforme instrução dos dias 
@type method
@version  
@author Harpia.Alfred
@since 06/06/2023
/*/
Method DeleteRecords() Class TSalesTable

	Local cUpdate as Character
	Local nUpdate as Numeric

	cUpdate := ""
	nUpdate := 0

	cUpdate := " DELETE VENDAS"
	cUpdate += " WHERE EMISSAO >= " + ValToSql(DTOS(::cDataLimite))

	cUpdate := UPPER(cUpdate)

	nUpdate := TcSqlExec(cUpdate)

	If (nUpdate < 0)
		ConOut("LOG DO UPDATE: " + TCSQLError())
	EndIf

	ConOut("Finalizado: DeleteRecords " + "Data " + DTOC(dDatabase) + " - " + TIME())

Return

/*/{Protheus.doc} TSalesTable::InsertRecords
Responsável pela consulta principal e Insert dos novos conteúdos 
@type method
@version 1 
@author Harpia.Alfred
@since 06/06/2023
/*/
Method InsertRecords() Class TSalesTable

	Local cInsert as Character
	Local nInsert as Numeric

	cInsert := ""
	nInsert := 0
	
	cInsert += "INSERT INTO VENDAS "
	cInsert += "SELECT nn.EMISSAO,"
	cInsert += "       COD_FIL,"
	cInsert += "       DESC_FIL, "
	cInsert += "       NF,"
	cInsert += "       TIPONF,"
	cInsert += "       GRPROD, "
	cInsert += "       GRUPOPROD, "
	cInsert += "       COD_PRODUTO,"
	cInsert += "       PRODUTO, "
	cInsert += "       QUANTI, "
	cInsert += "       CFOP,"
	cInsert += "       TIPO,"
	cInsert += "       isnull(REGIAO, REGIAO_VEND) REGIAO,"
	cInsert += "       COD_MUN, "
	cInsert += "       MUNIC, "
	cInsert += "       ESTADO, "
	cInsert += "       COD_CLIENTE, "
	cInsert += "       LOJA, "
	cInsert += "       HISTORICO,"
	cInsert += "       COD_VEND, "
	cInsert += "       VENDEDOR, "
	cInsert += "       COD_OPERADOR, "
	cInsert += "       OPERADOR, "
	cInsert += "       VEND_UA1, "
	cInsert += "       NUAVEND1, "
	cInsert += "       VEND_UA2, "
	cInsert += "       NUAVEND2, "
	cInsert += "       TMK, "
	cInsert += "       VENDA, "
	cInsert += "       FRETE, "
	cInsert += "       DEVOLUCAO, "
	cInsert += "       PIPI, "
	cInsert += "       IPI, "
	cInsert += "       ST, "
	cInsert += "       RECEITA_BRUTA, "
	cInsert += "       PICMS, "
	cInsert += "       ICMS, "
	cInsert += "       PIS, "
	cInsert += "       COFINS, "
	cInsert += "       DESCONTO, "
	cInsert += "       RECEITA_LIQUIDA,  "
	cInsert += "       CUSTO, "
	cInsert += "       MARGEM_BRUTA, "
	cInsert += "       P_CUSTO, "
	cInsert += "       P_LUCRO, "
	cInsert += "       NCM, "
	cInsert += "       TIPOCLI, "
	cInsert += "       IE, "
	cInsert += "       SUFRAMA, "
	cInsert += "       GRPTRIB, "
	cInsert += "       TPESSOA, "
	cInsert += "       CNAE, "
	cInsert += "       SIMPLES, "
	cInsert += "       MT, "
	cInsert += "       NUMCTE, "
	cInsert += "       SERCTE, "
	cInsert += "       NQCTE, "
	cInsert += "       VALFRETE, "
	cInsert += "       PEDIDO, "
	cInsert += "       ITEM, "
	cInsert += "       PRCVEN, "
	cInsert += "       FORNECEDOR, "
	cInsert += "       NOTAORIGEM, "
	cInsert += "       DUPLIC, "
	cInsert += "       GERENTEUA1, "
	cInsert += "       NOMEGERENTEUA1, "
	cInsert += "       NOME_GERENTEUA1, "
	cInsert += "       METAS_VEND.DIAS_MES, "
	cInsert += "       METAS_VEND.DIAS_PASSADOS, "
	cInsert += "       METAS_VEND.META AS META_UA1, "
	cInsert += "       isnull(METAS_VEND2.META, 0.01) AS META_UA2, "
	cInsert += "       B1_PROC, "
	cInsert += "       GERENTE_UA2, "
	cInsert += "       VEND_UA2+'-'+NUAVEND2 NOME_VEND2, "
	cInsert += "       REGIAO_VEND "
	cInsert += "FROM "
	cInsert += "  (SELECT SD2.D2_EMISSAO [EMISSAO], "
	cInsert += "          SD2.D2_FILIAL [COD_FIL], "
	cInsert += "          CASE  "
	cInsert += "               WHEN SD2.D2_FILIAL = '010101' THEN 'SENTAX - CURITIBA' "
	cInsert += "               WHEN SD2.D2_FILIAL = '020201' THEN 'GIBRALTAR - CURITIBA' "
	cInsert += "              WHEN SD2.D2_FILIAL = '020202' THEN 'GIBRALTAR - FOZ DO IGUACU' "
	cInsert += "              WHEN SD2.D2_FILIAL = '020203' THEN 'GIBRALTAR - JOINVILLE'"
	cInsert += "              WHEN SD2.D2_FILIAL = '020204' THEN 'GIBRALTAR - MARILIA' "
	cInsert += "              WHEN SD2.D2_FILIAL = '020205' THEN 'GIBRALTAR - SAO JOSE DOS PINHAIS' "
	cInsert += "              WHEN SD2.D2_FILIAL = '030301' THEN 'ARVOREDO - JOINVILLE'"
	cInsert += "              WHEN SD2.D2_FILIAL = '040401' THEN 'RADICAL CONSULTORIA DE MARKETING' "
	cInsert += "              WHEN SD2.D2_FILIAL = '020207' THEN 'GIBRALTAR - CAMPO GRANDE' "
	cInsert += "          END [DESC_FIL], "
	cInsert += "          SD2.D2_DOC [NF], "
	cInsert += "          SF2.F2_TIPO [TIPONF], "
	cInsert += "          SB1.B1_GRUPO [GRPROD], "
	cInsert += "          SBM.BM_DESC [GRUPOPROD], "
	cInsert += "          SD2.D2_COD [COD_PRODUTO], "
	cInsert += "          SB1.B1_DESC [PRODUTO], "
	cInsert += "          SD2.D2_QUANT [QUANTI], "
	cInsert += "          SD2.D2_CF [CFOP], "
	cInsert += "          SB1.B1_TIPO [TIPO], "
	cInsert += "          REGIAO_VEND.X5_DESCRI [REGIAO], "
	cInsert += "          SA1.A1_COD_MUN [COD_MUN], "
	cInsert += "          SA1.A1_MUN [MUNIC], "
	cInsert += "          SD2.D2_EST [ESTADO], "
	cInsert += "          SA1.A1_COD [COD_CLIENTE], "
	cInsert += "          SA1.A1_LOJA [LOJA], "
	cInsert += "          SA1.A1_NOME [HISTORICO], "
	cInsert += "          SA1.A1_VEND [COD_VEND], "
	cInsert += "          A3VEN.A3_NREDUZ [VENDEDOR], "
	cInsert += "          SUA.UA_OPERADO [COD_OPERADOR], "
	cInsert += "          SU7.U7_NOME [OPERADOR], "
	cInsert += "          SUA.UA_VEND [VEND_UA1], "
	cInsert += "          VEND1UA.A3_NREDUZ [NUAVEND1], "
	cInsert += "          SUA.UA_VEND2 [VEND_UA2], "
	cInsert += "          VEND2UA.A3_NREDUZ [NUAVEND2], "
	cInsert += "          CASE "
	cInsert += "              WHEN SUA.UA_TMK = '1' THEN 'RECEPTIVO' "
	cInsert += "              WHEN SUA.UA_TMK = '2' THEN 'ATIVO'"
	cInsert += "              WHEN SUA.UA_TMK = '3' THEN 'PARCERIA' "
	cInsert += "              WHEN SUA.UA_TMK = '4' THEN 'REPRESENTANTE' "
	cInsert += "              WHEN SUA.UA_TMK = '5' THEN 'RETORNO ATIVO' "
	cInsert += "              WHEN SUA.UA_TMK = '6' THEN 'COTA��O'"
	cInsert += "              WHEN SUA.UA_TMK = '7' THEN 'ORDEM DE SERVI�O' "
	cInsert += "              WHEN SUA.UA_TMK = '8' THEN 'E-MAIL'"
	cInsert += "              WHEN SUA.UA_TMK = '9' THEN 'WHATSAPP' "
	cInsert += "              WHEN SUA.UA_TMK = 'S' THEN 'SITE' "
	cInsert += "          END [TMK],                            "
	cInsert += "          SD2.D2_VALBRUT [VENDA],               "
	cInsert += "          SD2.D2_VALFRE [FRETE],                "
	cInsert += "          0 [DEVOLUCAO],                        "
	cInsert += "          SD2.D2_IPI [PIPI],                    "
	cInsert += "          SD2.D2_VALIPI [IPI],                  "
	cInsert += "          CASE                                  "
	cInsert += "              WHEN SD2.D2_CF NOT IN ('5949',    "
	cInsert += "                                     '6102') THEN (SD2.D2_ICMSRET)                                               "
	cInsert += "              ELSE 0                            "
	cInsert += "          END [ST],                             "
	cInsert += "          ROUND(((SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE                                                         "
	cInsert += "                                                        WHEN SD2.D2_CF NOT IN ('5949', '6102') THEN (SD2.D2_ICMSRET)   "
	cInsert += "                                                        ELSE 0                                                   "
	cInsert += "                                                    END))), 2) [RECEITA_BRUTA],                                  "
	cInsert += "          SD2.D2_PICM [PICMS],                  "
	cInsert += "          SD2.D2_VALICM [ICMS],                 "
	cInsert += "          SD2.D2_VALIMP6 [PIS],                 "
	cInsert += "          SD2.D2_VALIMP5 [COFINS],              "
	cInsert += "          SD2.D2_DESCZFC + SD2.D2_DESCZFP [DESCONTO],                                                            "
	cInsert += "          (SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE                                                                "
	cInsert += "                                                 WHEN SD2.D2_CF NOT IN ('5949',                                  "
	cInsert += "       '6102') THEN SD2.D2_ICMSRET              "
	cInsert += "                                                 ELSE 0                                                          "
	cInsert += "                                             END) - (CASE                                                        "
	cInsert += "                                                         WHEN SD2.D2_CF NOT IN ('6110') THEN (SD2.D2_DESCZFC - SD2.D2_DESCZFP)                                                          "
	cInsert += "                                                         ELSE 0                                                  "
	cInsert += "                                                     END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5) [RECEITA_LIQUIDA],                                                         "
	cInsert += "          SD2.D2_CUSTO1 [CUSTO],                "
	cInsert += "          SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE"
	cInsert += "                                                WHEN SD2.D2_CF NOT IN ('6110') THEN SD2.D2_DESCZFC - SD2.D2_DESCZFP    "
	cInsert += "                                                ELSE 0                                                           "
	cInsert += "                                            END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5 - SD2.D2_CUSTO1 - (CASE                                                              "
	cInsert += "                                                         WHEN SD2.D2_CF NOT IN ('5949',                                "
	cInsert += "         '6102') THEN SD2.D2_ICMSRET            "
	cInsert += "                                                         ELSE 0                                                        "
	cInsert += "                                                     END) [MARGEM_BRUTA],                                              "
	cInsert += "          SD2.D2_CUSTO1 / (SD2.D2_VALBRUT - D2_VALIPI - (CASE                                                    "
	cInsert += "                                                             WHEN SD2.D2_CF NOT IN ('5949',                      "
	cInsert += "                   '6102')                      "
	cInsert += " AND SD2.D2_ICMSRET < SD2.D2_VALBRUT - SD2.D2_VALIPI THEN SD2.D2_ICMSRET                                               "
	cInsert += "                                                             WHEN SD2.D2_VALBRUT - SD2.D2_VALIPI = SD2.D2_ICMSRET THEN 1                                                                "
	cInsert += "                                                             ELSE 0                                              "
	cInsert += "                                                         END)) * 100 [P_CUSTO],                                  "
	cInsert += "          ((SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE                                                               "
	cInsert += "                                                  WHEN SD2.D2_CF NOT IN ('6110') THEN (SD2.D2_DESCZFC - SD2.D2_DESCZFP)"
	cInsert += "                                                  ELSE 0                                                         "
	cInsert += "                                              END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5 - SD2.D2_CUSTO1 - (CASE                                                            "
	cInsert += "                                                           WHEN SD2.D2_CF NOT IN ('5949',                              "
	cInsert += "           '6102') THEN SD2.D2_ICMSRET          "
	cInsert += "                                                           ELSE 0                                                      "
	cInsert += "                                                       END)) / (SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE                 "
	cInsert += "                               WHEN SD2.D2_CF NOT IN ('5949',                                                    "
	cInsert += "                                                      '6102')                                                    "
	cInsert += "                                    AND SD2.D2_ICMSRET < (SD2.D2_VALBRUT - SD2.D2_VALIPI) THEN SD2.D2_ICMSRET    "
	cInsert += "                               WHEN (SD2.D2_VALBRUT - SD2.D2_VALIPI)= SD2.D2_ICMSRET THEN 1"
	cInsert += "                               ELSE 0 "
	cInsert += "                           END)) * 100) [P_LUCRO], "
	cInsert += "          SB1.B1_POSIPI [NCM],                  "
	cInsert += "          SA1.A1_TIPO [TIPOCLI],                "
	cInsert += "          SA1.A1_INSCR [IE],                    "
	cInsert += "          SA1.A1_SUFRAMA [SUFRAMA],             "
	cInsert += "          SA1.A1_GRPTRIB [GRPTRIB],             "
	cInsert += "          SA1.A1_TPESSOA [TPESSOA],             "
	cInsert += "          SA1.A1_CNAE [CNAE],                   "
	cInsert += "          SA1.A1_SIMPNAC [SIMPLES],             "
	cInsert += "          SA1.A1_REGESIM [MT],                  "
	cInsert += "          isnull(Z7Z.CTE, '') [NUMCTE],         "
	cInsert += "          '   ' [SERCTE],                       "
	cInsert += "                0 NQCTE,                        "
	cInsert += "                0 [VALFRETE],                   "
	cInsert += "                SD2.D2_PEDIDO [PEDIDO],         "
	cInsert += "                SD2.D2_ITEM [ITEM],             "
	cInsert += "                SD2.D2_PRCVEN [PRCVEN],         "
	cInsert += "                SA2.A2_NOME [FORNECEDOR],       "
	cInsert += "                '' [NOTAORIGEM],                "
	cInsert += "                   F4_DUPLIC DUPLIC,            "
	cInsert += "                   GERENTE_UA1.A3_COD AS GERENTEUA1,                                                             "
	cInsert += "                   GERENTE_UA1.A3_NOME AS NOMEGERENTEUA1,                                                        "
	cInsert += "                   GERENTE_UA1.A3_COD+'-'+GERENTE_UA1.A3_NOME AS NOME_GERENTEUA1,                                "
	cInsert += "                   B1_PROC,                     "
	cInsert += "                   GERENTE_UA2.A3_COD+' - '+GERENTE_UA2.A3_NOME GERENTE_UA2,                                     "
	cInsert += "                   REGIAO.X5_DESCRI [REGIAO_VEND]                                                                "
	cInsert += "   FROM SD2010 SD2  (nolock)                "
	cInsert += "   INNER JOIN SF4010 SF4 ON F4_FILIAL = SUBSTRING(D2_FILIAL, 1, 4)                                               "
	cInsert += "   AND F4_CODIGO = D2_TES                       "
	cInsert += "   AND SF4.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SF2010 SF2  (nolock) ON SF2.F2_FILIAL = SD2.D2_FILIAL                                          "
	cInsert += "   AND SF2.F2_DOC = SD2.D2_DOC                  "
	cInsert += "   AND SF2.F2_SERIE = SD2.D2_SERIE              "
	cInsert += "   AND SF2.F2_CLIENTE = SD2.D2_CLIENTE          "
	cInsert += "   AND SF2.F2_LOJA = SD2.D2_LOJA                                                         						 "
	cInsert += "                                                "
	cInsert += "   AND SF2.F2_TIPO IN ('N',                     "
	cInsert += "                       'D')                     "
	cInsert += "   AND SF2.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN                                    "
	cInsert += "     (SELECT Z7Z_FILIAL,                        "
	cInsert += "             Z7Z_NOTA,                          "
	cInsert += "             Z7Z_SERINF,                        "
	cInsert += "             SUM(Z6Z_VALTOT) VALOR,             "
	cInsert += "             STUFF(                             "
	cInsert += "                     (SELECT+ '; ' + Z7Z_DOC    "
	cInsert += "                      FROM Z7Z010 AS XX  (nolock)                                                            "
	cInsert += "                      WHERE XX.Z7Z_NOTA=Z7Z.Z7Z_NOTA                                                             "
	cInsert += "                        AND XX.Z7Z_SERINF = Z7Z.Z7Z_SERINF                                                       "
	cInsert += "                        FOR XML path('')), 1, 1, '') AS CTE                                                      "
	cInsert += "      FROM Z7Z010 Z7Z  (nolock)             "
	cInsert += "      INNER JOIN Z6Z010 Z6Z  (nolock) ON Z6Z_FILIAL = Z7Z_FILIAL                                             "
	cInsert += "      AND Z6Z_DOC = Z7Z_DOC                     "
	cInsert += "      AND Z6Z_SERIE =Z7Z_SERIE                  "
	cInsert += "      AND Z6Z.D_E_L_E_T_= ''                   "
	cInsert += "      GROUP BY Z7Z_FILIAL,                      "
	cInsert += "               Z7Z_NOTA,                        "
	cInsert += "               Z7Z_SERINF) Z7Z ON Z7Z.Z7Z_FILIAL = SD2.D2_FILIAL                                                 "
	cInsert += "   AND Z7Z.Z7Z_SERINF = SD2.D2_SERIE            "
	cInsert += "   AND Z7Z.Z7Z_NOTA = SD2.D2_DOC                "
	cInsert += "   LEFT JOIN SUA010 SUA  (nolock) ON SUA.UA_FILIAL = SD2.D2_FILIAL                                           "
	cInsert += "   AND SUA.UA_SERIE = SD2.D2_SERIE              "
	cInsert += "   AND SUA.UA_DOC = SD2.D2_DOC                  "
	cInsert += "   AND SUA.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SU7010 SU7  (nolock) ON SU7.U7_COD = SUA.UA_OPERADO                                             "
	cInsert += "   AND SU7.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SA1010 SA1  (nolock) ON SA1.A1_COD = SD2.D2_CLIENTE                                            "
	cInsert += "   AND SA1.A1_LOJA = SD2.D2_LOJA 																	             "
	cInsert += "   AND SA1.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SB1010 SB1  (nolock) ON SB1.B1_COD = SD2.D2_COD                                                "
	cInsert += "   AND SB1.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SBM010 SBM  (nolock) ON SB1.B1_GRUPO = SBM.BM_GRUPO                                            "
	cInsert += "   AND SBM.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SA3010 A3VEN  (nolock) ON A3VEN.A3_COD = SA1.A1_VEND                                            "
	cInsert += "   AND A3VEN.D_E_L_E_T_= ''                    "
	cInsert += "   LEFT JOIN SA3010 VEND1UA  (nolock) ON VEND1UA.A3_COD = SUA.UA_VEND                                        "
	cInsert += "   AND VEND1UA.D_E_L_E_T_= ''                  "
	cInsert += "   LEFT JOIN SA3010 GERENTE_UA1 ON GERENTE_UA1.A3_COD = VEND1UA.A3_GEREN                                         "
	cInsert += "   AND GERENTE_UA1.D_E_L_E_T_= ''              "
	cInsert += "   AND GERENTE_UA1.A3_MSBLQL<>'1'               "
	cInsert += "   LEFT JOIN SA3010 VEND2UA  (nolock) ON VEND2UA.A3_COD = SUA.UA_VEND2                                       "
	cInsert += "   AND VEND2UA.D_E_L_E_T_= ''                  "
	cInsert += "   LEFT JOIN SA3010 GERENTE_UA2  (nolock) ON GERENTE_UA2.A3_COD = VEND2UA.A3_GEREN                           "
	cInsert += "   AND GERENTE_UA2.D_E_L_E_T_= ''              "
	cInsert += "   AND GERENTE_UA2.A3_MSBLQL<>'1'               "
	cInsert += "   LEFT JOIN SX5010 REGIAO  (nolock) ON REGIAO.X5_TABELA = 'A2'                                              "
	cInsert += "   AND REGIAO.X5_CHAVE = A1_REGIAO              "
	cInsert += "   AND REGIAO.D_E_L_E_T_= ''                   "
	cInsert += "   LEFT JOIN SA2010 SA2 ON A2_COD = B1_PROC     "
	cInsert += "   AND A2_LOJA = B1_LOJPROC                     "
	cInsert += "   AND SA2.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SCT010 SCT ON CT_FILIAL='010101'   "
	cInsert += "   AND CT_VEND = VEND1UA.A3_COD                 "
	cInsert += "   AND SCT.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SX5010 REGIAO_VEND  (nolock) ON REGIAO_VEND.X5_TABELA = 'Z4'                                    "
	cInsert += "   AND REGIAO_VEND.X5_CHAVE = CT_REGIAO         "
	cInsert += "   AND REGIAO_VEND.D_E_L_E_T_= ''              "
	cInsert += "   WHERE SD2.D_E_L_E_T_= ''                    "
	cInsert += "     AND SD2.D2_CF NOT IN ('6202',              "
	cInsert += "                           '6411')              "
	cInsert += "     AND SD2.D2_EMISSAO >= " + ValToSql(DTOS(::cDataLimite))
	cInsert += "UNION ALL SELECT SD1.D1_EMISSAO [EMISSAO],      "
	cInsert += "                 SD2.D2_FILIAL [COD_FIL],       "
	cInsert += "                 CASE                           "
	cInsert += "                     WHEN SD2.D2_FILIAL = '010101' THEN 'SENTAX - CURITIBA'                                      "
	cInsert += "                     WHEN SD2.D2_FILIAL = '020201' THEN 'GIBRALTAR - CURITIBA'                                   "
	cInsert += "                     WHEN SD2.D2_FILIAL = '020202' THEN 'GIBRALTAR - FOZ DO IGUACU'                              "
	cInsert += "                     WHEN SD2.D2_FILIAL = '020203' THEN 'GIBRALTAR - JOINVILLE'                                  "
	cInsert += "                     WHEN SD2.D2_FILIAL = '020204' THEN 'GIBRALTAR - MARILIA'                                    "
	cInsert += "                     WHEN SD2.D2_FILIAL = '020205' THEN 'GIBRALTAR - SAO JOSE DOS PINHAIS'                       "
	cInsert += "                     WHEN SD2.D2_FILIAL = '030301' THEN 'ARVOREDO - JOINVILLE'                                   "
	cInsert += "                     WHEN SD2.D2_FILIAL = '040401' THEN 'RADICAL CONSULTORIA DE MARKETING'                       "
	cInsert += "              		 WHEN SD2.D2_FILIAL = '020207' THEN 'GIBRALTAR - CAMPO GRANDE' 								 "
	cInsert += "                 END [DESC_FIL],                "
	cInsert += "                 SD1.D1_DOC [NF],               "
	cInsert += "                 SD1.D1_TIPO [TIPONF],          "
	cInsert += "                 SB1.B1_GRUPO [GRPROD],         "
	cInsert += "                 SBM.BM_DESC [GRUPOPROD],       "
	cInsert += "                 SD2.D2_COD [COD_PRODUTO],      "
	cInsert += "                 SB1.B1_DESC [PRODUTO],         "
	cInsert += "                 SD2.D2_QUANT [QUANTI],         "
	cInsert += "                 SD1.D1_CF [CFOP],              "
	cInsert += "                 SB1.B1_TIPO [TIPO],            "
	cInsert += "                 REGIAO_VEND.X5_DESCRI [REGIAO],"
	cInsert += "                 SA1.A1_COD_MUN [COD_MUN],      "
	cInsert += "                 SA1.A1_MUN [MUNIC],            "
	cInsert += "                 SD2.D2_EST [ESTADO],           "
	cInsert += "                 SA1.A1_COD [COD_CLIENTE],      "
	cInsert += "                 SA1.A1_LOJA [LOJA],            "
	cInsert += "                 SA1.A1_NOME [HISTORICO],       "
	cInsert += "                 SA1.A1_VEND [COD_VEND],        "
	cInsert += "                 A3VEN.A3_NREDUZ [VENDEDOR],    "
	cInsert += "                 SUA.UA_OPERADO [COD_OPERADOR], "
	cInsert += "                 SU7.U7_NOME [OPERADOR],        "
	cInsert += "                 SUA.UA_VEND [VEND_UA1],        "
	cInsert += "                 VEND1UA.A3_NREDUZ [NUAVEND1],  "
	cInsert += "                 SUA.UA_VEND2 [VEND_UA2],       "
	cInsert += "                 VEND2UA.A3_NREDUZ [NUAVEND2],  "
	cInsert += "                 CASE                           "
	cInsert += "                     WHEN SUA.UA_TMK = '1' THEN 'RECEPTIVO'                                                      "
	cInsert += "                     WHEN SUA.UA_TMK = '2' THEN 'ATIVO'                                                          "
	cInsert += "                     WHEN SUA.UA_TMK = '3' THEN 'PARCERIA'                                                 "
	cInsert += "                     WHEN SUA.UA_TMK = '4' THEN 'REPRESENTANTE'                                                  "
	cInsert += "                     WHEN SUA.UA_TMK = '5' THEN 'RETORNO ATIVO'                                                  "
	cInsert += "                     WHEN SUA.UA_TMK = '6' THEN 'COTA��O'                                                        "
	cInsert += "                     WHEN SUA.UA_TMK = '7' THEN 'ORDEM DE SERVI�O'                                               "
	cInsert += "                     WHEN SUA.UA_TMK = '8' THEN 'E-MAIL'                                                         "
	cInsert += "                     WHEN SUA.UA_TMK = '9' THEN 'WHATSAPP'                                                       "
	cInsert += "                     WHEN SUA.UA_TMK = 'S' THEN 'SITE'                                                           "
	cInsert += "                 END [TMK],                     "
	cInsert += "                 SD1.D1_TOTAL *(-1) + D1_VALDESC [VENDA],                                                        "
	cInsert += "                 SD2.D2_VALFRE *(-1) [FRETE],	                                      							 "
	cInsert += " SD1.D1_TOTAL [DEVOLUCAO],                      "
	cInsert += " SD2.D2_IPI [PIPI],                             "
	cInsert += " SD2.D2_VALIPI [IPI],                           "
	cInsert += " CASE                                           "
	cInsert += "     WHEN SD2.D2_CF NOT IN ('5949',             "
	cInsert += "                            '6102') THEN (SD2.D2_ICMSRET)                                                        "
	cInsert += "     ELSE 0                                     "
	cInsert += " END [ST],                                      "
	cInsert += " ROUND(((SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE "
	cInsert += "                                               WHEN SD2.D2_CF NOT IN ('5949', '6102') THEN (SD2.D2_ICMSRET)      "
	cInsert += "                                               ELSE 0                                                            "
	cInsert += "                                           END))), 2) [RECEITA_BRUTA],                                           "
	cInsert += " SD2.D2_PICM [PICMS],                           "
	cInsert += " SD2.D2_VALICM [ICMS],                          "
	cInsert += " SD2.D2_VALIMP6 [PIS],                          "
	cInsert += " SD2.D2_VALIMP5 [COFINS],                       "
	cInsert += " SD2.D2_DESCZFC + SD2.D2_DESCZFP [DESCONTO],    "
	cInsert += " (SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE        "
	cInsert += "                                        WHEN SD2.D2_CF NOT IN ('5949',                                           "
	cInsert += "                                                               '6102') THEN SD2.D2_ICMSRET                       "
	cInsert += "                                        ELSE 0  "
	cInsert += "                                    END) - (CASE"
	cInsert += "                                                WHEN SD2.D2_CF NOT IN ('6110') THEN (SD2.D2_DESCZFC - SD2.D2_DESCZFP)  "
	cInsert += "                                                ELSE 0                                                           "
	cInsert += "                                            END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5) [RECEITA_LIQUIDA], "
	cInsert += " SD2.D2_CUSTO1 [CUSTO],                         "
	cInsert += " SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE         "
	cInsert += "                                       WHEN SD2.D2_CF NOT IN ('6110') THEN SD2.D2_DESCZFC - SD2.D2_DESCZFP       "
	cInsert += "                                       ELSE 0   "
	cInsert += "                                   END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5 - SD2.D2_CUSTO1 - (CASE"
	cInsert += "                                                WHEN SD2.D2_CF NOT IN ('5949',                                         "
	cInsert += "'6102') THEN SD2.D2_ICMSRET                     "
	cInsert += "                                                ELSE 0"
	cInsert += "                                            END) [MARGEM_BRUTA],                                                       "
	cInsert += " SD2.D2_CUSTO1 / (SD2.D2_VALBRUT - D2_VALIPI - (CASE                                                             "
	cInsert += "                                                    WHEN SD2.D2_CF NOT IN ('5949',                               "
	cInsert += "          '6102')                               "
	cInsert += "                                                         AND SD2.D2_ICMSRET < SD2.D2_VALBRUT - SD2.D2_VALIPI THEN SD2.D2_ICMSRET                                                        "
	cInsert += "                                                    WHEN SD2.D2_VALBRUT - SD2.D2_VALIPI = SD2.D2_ICMSRET THEN 1  "
	cInsert += "                                                    ELSE 0                                                       "
	cInsert += "                                                END)) * 100 [P_CUSTO],                                           "
	cInsert += " ((SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE       "
	cInsert += "                                         WHEN SD2.D2_CF NOT IN ('6110') THEN (SD2.D2_DESCZFC - SD2.D2_DESCZFP)   "
	cInsert += "                                         ELSE 0 "
	cInsert += "                                     END) - SD2.D2_VALICM - SD2.D2_VALIMP6 - SD2.D2_VALIMP5 - SD2.D2_CUSTO1 - (CASE    "
	cInsert += "                                                  WHEN SD2.D2_CF NOT IN ('5949',                                       "
	cInsert += "  '6102') THEN SD2.D2_ICMSRET                   "
	cInsert += "                                                  ELSE 0                                                               "
	cInsert += "                                              END)) / (SD2.D2_VALBRUT - SD2.D2_VALIPI - (CASE                          "
	cInsert += "                      WHEN SD2.D2_CF NOT IN ('5949',                                                             "
	cInsert += "                                             '6102')                                                             "
	cInsert += "                           AND SD2.D2_ICMSRET < (SD2.D2_VALBRUT - SD2.D2_VALIPI) THEN SD2.D2_ICMSRET             "
	cInsert += "                      WHEN (SD2.D2_VALBRUT - SD2.D2_VALIPI)= SD2.D2_ICMSRET THEN 1                               "
	cInsert += "                      ELSE 0                    "
	cInsert += "                  END)) * 100) [P_LUCRO],       "
	cInsert += " SB1.B1_POSIPI [NCM],                           "
	cInsert += " SA1.A1_TIPO [TIPOCLI],                         "
	cInsert += " SA1.A1_INSCR [IE],                             "
	cInsert += " SA1.A1_SUFRAMA [SUFRAMA],                      "
	cInsert += " SA1.A1_GRPTRIB [GRPTRIB],                      "
	cInsert += " SA1.A1_TPESSOA [TPESSOA],                      "
	cInsert += " SA1.A1_CNAE [CNAE],                            "
	cInsert += " SA1.A1_SIMPNAC [SIMPLES],                      "
	cInsert += " SA1.A1_REGESIM [MT],                           "
	cInsert += " isnull(Z7Z.CTE, '') [NUMCTE],                  "
	cInsert += " '   ' [SERCTE],                                "
	cInsert += "       0 NQCTE,                                 "
	cInsert += "       0 [VALFRETE],                            "
	cInsert += "       SD2.D2_PEDIDO [PEDIDO],                  "
	cInsert += "       SD2.D2_ITEM [ITEM],                      "
	cInsert += "       SD2.D2_PRCVEN [PRCVEN],                  "
	cInsert += "       SA2.A2_NOME [FORNECEDOR],                "
	cInsert += "       SD1.D1_NFORI [NOTAORIGEM],               "
	cInsert += "       F4_DUPLIC,                               "
	cInsert += "       GERENTE_UA1.A3_COD AS GERENTEUA1,        "
	cInsert += "       GERENTE_UA1.A3_NOME AS NOMEGERENTEUA1,   "
	cInsert += "       GERENTE_UA1.A3_COD+'-'+GERENTE_UA1.A3_NOME AS NOME_GERENTEUA1,                                            "
	cInsert += "       B1_PROC,                                 "
	cInsert += "       GERENTE_UA2.A3_COD+' - '+GERENTE_UA2.A3_NOME AS GERENTE_UA2,                                              "
	cInsert += "       REGIAO.X5_DESCRI [REGIAO_VEND]           "
	cInsert += "   FROM SD2010 SD2  (nolock)                "
	cInsert += "   INNER JOIN SF4010 SF4  (nolock) ON F4_FILIAL = SUBSTRING(D2_FILIAL, 1, 4)                                 "
	cInsert += "   AND F4_CODIGO = D2_TES                       "
	cInsert += "   AND SF4.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SF2010 SF2  (nolock) ON SF2.F2_FILIAL = SD2.D2_FILIAL                                          "
	cInsert += "   AND SF2.F2_DOC = SD2.D2_DOC                  "
	cInsert += "   AND SF2.F2_SERIE = SD2.D2_SERIE              "
	cInsert += "   AND SF2.F2_CLIENTE = SD2.D2_CLIENTE          "
	cInsert += "   AND SF2.F2_LOJA = SD2.D2_LOJA                "
	cInsert += "   AND SF2.F2_TIPO IN ('N',                     "
	cInsert += "                       'D')                     "
	cInsert += "   AND SF2.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SD1010 SD1  (nolock) ON D1_FILIAL = D2_FILIAL                                                  "
	cInsert += "   AND D1_NFORI = D2_DOC                        "
	cInsert += "   AND D1_SERIORI = D2_SERIE                    "
	cInsert += "   AND D1_ITEMORI = D2_ITEM                     "
	cInsert += "   AND SD1.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN                                    "
	cInsert += "     (SELECT Z7Z_FILIAL,                        "
	cInsert += "             Z7Z_NOTA,                          "
	cInsert += "             Z7Z_SERINF,                        "
	cInsert += "             SUM(Z6Z_VALTOT) VALOR,             "
	cInsert += "             STUFF(                             "
	cInsert += "                     (SELECT+ '; ' + Z7Z_DOC    "
	cInsert += "                      FROM Z7Z010 AS XX  (nolock)                                                            "
	cInsert += "                      WHERE XX.Z7Z_NOTA=Z7Z.Z7Z_NOTA                                                             "
	cInsert += "                        AND XX.Z7Z_SERINF = Z7Z.Z7Z_SERINF                                                       "
	cInsert += "                        FOR XML path('')), 1, 1, '') AS CTE                                                      "
	cInsert += "      FROM Z7Z010 Z7Z  (nolock)             "
	cInsert += "      INNER JOIN Z6Z010 Z6Z ON Z6Z_FILIAL = Z7Z_FILIAL                                                           "
	cInsert += "      AND Z6Z_DOC = Z7Z_DOC                     "
	cInsert += "      AND Z6Z_SERIE =Z7Z_SERIE                  "
	cInsert += "      AND Z6Z.D_E_L_E_T_= ''                   "
	cInsert += "      GROUP BY Z7Z_FILIAL,                      "
	cInsert += "               Z7Z_NOTA,                        "
	cInsert += "               Z7Z_SERINF)Z7Z ON Z7Z.Z7Z_FILIAL = SD2.D2_FILIAL                                                  "
	cInsert += "   AND Z7Z.Z7Z_SERINF = SD2.D2_SERIE            "
	cInsert += "   AND Z7Z.Z7Z_NOTA = SD2.D2_DOC                "
	cInsert += "   LEFT JOIN SUA010 SUA  (nolock) ON SUA.UA_FILIAL = SD2.D2_FILIAL                                           "
	cInsert += "   AND SUA.UA_SERIE = SD2.D2_SERIE              "
	cInsert += "   AND SUA.UA_DOC = SD2.D2_DOC                  "
	cInsert += "   AND SUA.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SU7010 SU7  (nolock) ON SU7.U7_COD = SUA.UA_OPERADO                                             "
	cInsert += "   AND SU7.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SA1010 SA1  (nolock) ON SA1.A1_COD = SD2.D2_CLIENTE                                            "
	cInsert += "   AND SA1.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SB1010 SB1  (nolock) ON SB1.B1_COD = SD2.D2_COD                                                "
	cInsert += "   AND SB1.D_E_L_E_T_= ''                      "
	cInsert += "   INNER JOIN SBM010 SBM  (nolock) ON SB1.B1_GRUPO = SBM.BM_GRUPO                                            "
	cInsert += "   AND SBM.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SA3010 A3VEN  (nolock) ON A3VEN.A3_COD = SA1.A1_VEND                                            "
	cInsert += "   AND A3VEN.D_E_L_E_T_= ''                    "
	cInsert += "   LEFT JOIN SA3010 VEND1UA  (nolock) ON VEND1UA.A3_COD = SUA.UA_VEND                                        "
	cInsert += "   AND VEND1UA.D_E_L_E_T_= ''                  "
	cInsert += "   LEFT JOIN SA3010 GERENTE_UA1 ON GERENTE_UA1.A3_COD = VEND1UA.A3_GEREN                                         "
	cInsert += "   AND GERENTE_UA1.D_E_L_E_T_= ''              "
	cInsert += "   AND GERENTE_UA1.A3_MSBLQL<>'1'               "
	cInsert += "   LEFT JOIN SA3010 VEND2UA  (nolock) ON VEND2UA.A3_COD = SUA.UA_VEND2                                       "
	cInsert += "   AND VEND2UA.D_E_L_E_T_= ''                  "
	cInsert += "   LEFT JOIN SA3010 GERENTE_UA2 ON GERENTE_UA2.A3_COD = VEND2UA.A3_GEREN                                         "
	cInsert += "   AND GERENTE_UA2.D_E_L_E_T_= ''              "
	cInsert += "   AND GERENTE_UA2.A3_MSBLQL<>'1'               "
	cInsert += "   LEFT JOIN SX5010 REGIAO  (nolock) ON REGIAO.X5_TABELA = 'A2'                                              "
	cInsert += "   AND REGIAO.X5_CHAVE = A1_REGIAO              "
	cInsert += "   AND REGIAO.D_E_L_E_T_= ''                   "
	cInsert += "   LEFT JOIN SCT010 SCT ON CT_FILIAL='010101'   "
	cInsert += "   AND CT_VEND = VEND1UA.A3_COD                 "
	cInsert += "   AND SCT.D_E_L_E_T_= ''                      "
	cInsert += "   LEFT JOIN SX5010 REGIAO_VEND  (nolock) ON REGIAO_VEND.X5_TABELA = 'Z4'                                    "
	cInsert += "   AND REGIAO_VEND.X5_CHAVE = CT_REGIAO         "
	cInsert += "   AND REGIAO_VEND.D_E_L_E_T_= ''              "
	cInsert += "   LEFT JOIN SA2010 SA2  (nolock) ON A2_COD = B1_PROC                                                        "
	cInsert += "   AND A2_LOJA = B1_LOJPROC                     "
	cInsert += "   AND SA2.D_E_L_E_T_= ''                      "
	cInsert += "   WHERE SD2.D_E_L_E_T_= ''                    "
	cInsert += "     AND SD2.D2_CF NOT IN ('6202',              "
	cInsert += "                           '6411')              "
	cInsert += "     AND SD1.D1_EMISSAO >= " +ValToSql(DTOS(::cDataLimite)) +")nn "
	cInsert += "LEFT JOIN                                       "
	cInsert += "  (SELECT STXMETA_FILIAL FILIAL,                "
	cInsert += "          SUBSTRING(STXMETA_EMISSAO, 1, 6) ANOMES,                                                               "
	cInsert += "          STXMETA_VEND VEND,                    "
	cInsert += "          STXMETA_META META,                    "
	cInsert += "          STXMETA_TDIAS DIAS_MES,               "
	cInsert += "          MAX(STXMETA_TDIASP) DIAS_PASSADOS     "
	cInsert += "   FROM STXMETA  (nolock)                   "
	cInsert += "   GROUP BY STXMETA_FILIAL,                     "
	cInsert += "            STXMETA_VEND,                       "
	cInsert += "            SUBSTRING(STXMETA_EMISSAO, 1, 6),   "
	cInsert += "            STXMETA_META,                       "
	cInsert += "            STXMETA_TDIAS) AS METAS_VEND ON METAS_VEND.VEND = nn.VEND_UA1                                        "
	cInsert += "AND SUBSTRING(METAS_VEND.ANOMES, 1, 6) = SUBSTRING(nn.EMISSAO, 1, 6)                                             "
	cInsert += "LEFT JOIN                                       "
	cInsert += "  (SELECT STXMETA_FILIAL FILIAL,                "
	cInsert += "          SUBSTRING(STXMETA_EMISSAO, 1, 6) ANOMES,                                                               "
	cInsert += "          STXMETA_VEND VEND,                    "
	cInsert += "          STXMETA_META META,                    "
	cInsert += "          STXMETA_TDIAS DIAS_MES,               "
	cInsert += "          MAX(STXMETA_TDIASP) DIAS_PASSADOS     "
	cInsert += "   FROM STXMETA  (nolock)                   "
	cInsert += "   GROUP BY STXMETA_FILIAL,                     "
	cInsert += "            STXMETA_VEND,                       "
	cInsert += "            SUBSTRING(STXMETA_EMISSAO, 1, 6),   "
	cInsert += "            STXMETA_META,                       "
	cInsert += "            STXMETA_TDIAS) AS METAS_VEND2 ON METAS_VEND2.VEND = nn.VEND_UA2                                      "
	cInsert += "AND SUBSTRING(METAS_VEND2.ANOMES, 1, 6) = SUBSTRING(nn.EMISSAO, 1, 6)                                            "

	nInsert := TcSqlExec(cInsert)

	If (nInsert < 0)
		ConOut("LOG DO UPDATE: " + TCSQLError())
	EndIf

	ConOut("Finalizado: InsertRecords " + "Data " + DTOC(dDatabase) + " - " + TIME())

Return

/*/{Protheus.doc} TSales
Schedule de manutenção da tabela e View VENDAS
@type function
@version 1 
@author Alfred Andersen
@since 06/06/2023
@param aPars, array, 1 - Números de dias a ser atualizado | 2 - Empressa | 3 - Filial
/*/
User Function TSales(aPars)

	Local oObjeto 	:= TSalesTable():New()

	DEFAULT aPars   := {1,"01","020201"}

	RpcClearenv()

	RpcSetType( 3 )
	RpcSetEnv( aPars[2], aPars[3] )

	oObjeto:cDataLimite := dDataBase - aPars[1]
	oObjeto:Process()

	RpcClearEnv()

Return
